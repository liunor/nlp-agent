# Doubao-Seed-1.8配置
volcengine_API_KEY="xxx"

# 阿里云 embedding模型配置
aliyun_API_KEY="xxx"

# LangSmith配置
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY="xxx"

# 选填，建议填上，方便在界面里分类
LANGCHAIN_PROJECT="Agent"

# DeepSeek配置
DEEPSEEK_API_KEY=xxx

# Qwen 原生联网搜索与 Qwen 模型配置
QWEN_API_KEY=xxx

# 可选：使用云 OCR 时配置；本地 OCR 不需要。
NLP_AGENT_OCR_API_KEY=

# 生产 Web/Monitor 不读取固定账号；用户来自 MySQL nlp_users。
# 以下旧版测试适配器配置不应写入部署环境。
NLP_AGENT_AUTH_SESSION_TTL_S=1800
NLP_AGENT_AUTH_IDLE_TIMEOUT_S=900
NLP_AGENT_AUTH_MAX_LOGIN_ATTEMPTS=5
NLP_AGENT_AUTH_RATE_WINDOW_S=300
# Keep false for HTTP/IP bootstrap. Set true only after Nginx serves HTTPS.
NLP_AGENT_AUTH_COOKIE_SECURE=false

# 教师学习分析：小时/星期分布与高峰时段使用的时区（固定偏移，不支持夏令时）。
NLP_AGENT_ANALYTICS_TIMEZONE=Asia/Shanghai
# Successful read authorization checks are high-volume; denials and writes
# are always audited. Enable this only when full read-decision telemetry is
# required for a short investigation.
NLP_AGENT_AUDIT_SUCCESSFUL_READS=false
NLP_AGENT_SANDBOX_RUNTIME_MODE=disabled
NLP_AGENT_SANDBOX_RUNTIME_BACKEND=runsc
NLP_AGENT_SANDBOX_DOCKER_IMAGE_DIGEST=""
NLP_AGENT_SANDBOX_FIRECRACKER_KERNEL_IMAGE=""
NLP_AGENT_SANDBOX_FIRECRACKER_ROOTFS_IMAGE=""
NLP_AGENT_SANDBOX_WARM_POOL_READY_TARGET=0
NLP_AGENT_SANDBOX_ADAPTIVE_POOL_ENABLED=false
NLP_AGENT_SANDBOX_PROJECT_STORAGE_ENABLED=false
NLP_AGENT_SANDBOX_PROJECT_STORAGE_ROOT=""
NLP_AGENT_SANDBOX_SNAPSHOTS_ENABLED=false
NLP_AGENT_WEB_SECRET="CHANGE_ME_RANDOM_SECRET"

# Optional Phase 4 isolated runtime. Enable only when the dedicated
# `nova-sandbox-manager` service has the Docker socket and a pinned image.
NLP_AGENT_SANDBOX_RUNTIME_MODE=disabled
NLP_AGENT_SANDBOX_DOCKER_IMAGE_DIGEST=""
NLP_AGENT_SANDBOX_WARM_POOL_READY_TARGET=0
NLP_AGENT_SANDBOX_ADAPTIVE_POOL_ENABLED=false

# Redis transport. Set NLP_AGENT_GATEWAY_TRANSPORT=redis when Web and Worker run separately.
NLP_AGENT_REDIS_URL="redis://127.0.0.1:6379/0"
NLP_AGENT_GATEWAY_TRANSPORT="redis"
# Optional package.module:function factory for a shared MSSQL state adapter.
NLP_AGENT_STATE_FACTORY=""

# MySQL is the only runtime business-state database. In Docker Compose, use
# the `mysql` hostname below; for a managed server database replace host/port
# with its private endpoint. Never commit the production password.
NLP_AGENT_DATABASE_URL="mysql+aiomysql://nlp_agent:CHANGE_ME@mysql:3306/nlp_agent?charset=utf8mb4"
NLP_AGENT_MYSQL_DATABASE="nlp_agent"
NLP_AGENT_MYSQL_USER="nlp_agent"
NLP_AGENT_MYSQL_PASSWORD="CHANGE_ME"
NLP_AGENT_MYSQL_ROOT_PASSWORD="CHANGE_ME_ROOT"

# Nginx edge deployment. Replace SERVER_IP_OR_DOMAIN before use. For HTTPS,
# use the public domain and its https:// origin, without a backend port.
# Example: 192.168.1.20 or nova.example.com
NLP_AGENT_WEB_ALLOWED_HOSTS="localhost,127.0.0.1,SERVER_IP_OR_DOMAIN"
NLP_AGENT_WEB_ALLOWED_ORIGINS="http://SERVER_IP_OR_DOMAIN"
NLP_AGENT_MONITOR_ALLOWED_HOSTS="localhost,127.0.0.1,SERVER_IP_OR_DOMAIN"
NLP_AGENT_MONITOR_ALLOWED_ORIGINS="http://SERVER_IP_OR_DOMAIN:8766"

# Docker image reference. CI replaces this with the exact image digest that
# passed testing before deploying production.
NOVA_IMAGE_REF="nova-agent:local"
NOVA_PULL_POLICY="always"

# Nginx is the public Nova Web entry point. Monitor is published separately
# and should be reachable only from the internal network or VPN.
NOVA_WEB_HOST_PORT="80"
NOVA_MONITOR_HOST_PORT="8766"

# ------------------------------------------------------------------ #
#  Tencent Cloud SMS Configuration (for production)
# ------------------------------------------------------------------ #
# To enable real SMS verification, configure the following variables.
# Without them the endpoint returns 503 unless the explicit development switch
# below is set to true (only then is a code printed to the local console).
#
# Required steps before configuration:
# 1. Open Tencent Cloud Console → SMS → Create SMS application
# 2. Apply for SMS signature (must be approved)
# 3. Create SMS template for verification codes (e.g., "Your code is {1}")
# 4. Get your SecretId/SecretKey from CAM → API Key Management
#
# TENCENT_SMS_SECRET_ID="AKIDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TENCENT_SMS_SECRET_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TENCENT_SMS_APP_ID="1400xxxxxx"          # SMS SDK AppID
# TENCENT_SMS_SIGN_NAME="YourAppName"      # Approved signature name
# TENCENT_SMS_TEMPLATE_ID="1234567"        # Template ID for verification codes
# TENCENT_SMS_REGION="ap-guangzhou"        # Region (default: ap-guangzhou)
NLP_AGENT_SMS_DEVELOPMENT_MODE=false
