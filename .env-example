# ========================================================================== #
#  Nova environment configuration example (copy to .env and fill in)
#  - Items marked CHANGE_ME / xxx must be replaced with your own values and
#    must never be committed to Git.
#  - An empty value disables the optional feature; boolean values accept
#    true/false, 1/0, yes/no.
#  - See docs/ and configs/settings.py for the full reference.
# ========================================================================== #

# ------------------------------------------------------------------------ #
#  Model provider keys
# ------------------------------------------------------------------------ #
DEEPSEEK_API_KEY=xxx
QWEN_API_KEY=xxx
KIMI_API_KEY=xxx
GLM_API_KEY=xxx

# Legacy provider keys (only needed if they are still in use)
volcengine_API_KEY=
aliyun_API_KEY=

# Optional: force workers to use a specific model, overriding the default
# worker model in agent_config.yaml. Leave empty to use the config default.
NLP_AGENT_WORKER_MODEL=

# ------------------------------------------------------------------------ #
#  Academic search / Semantic Scholar / Crossref
# ------------------------------------------------------------------------ #
# Optional; when unset, the unauthenticated Semantic Scholar public rate limit
# is used. The default license covers internal, non-commercial research/
# educational use only. Before a public or commercial deployment you must
# review https://api.semanticscholar.org/license/ and complete brand
# attribution or obtain extended licensing.
SEMANTIC_SCHOLAR_API_KEY=

# Recommended: set a maintenance email for the Crossref polite pool (not a key).
ACADEMIC_CROSSREF_MAILTO=

# ------------------------------------------------------------------------ #
#  Vision / OCR
# ------------------------------------------------------------------------ #
# Optional: set when using a cloud OCR provider; local OCR needs nothing here.
NLP_AGENT_OCR_API_KEY=

# Upload persistence directory; defaults to .data/uploads.
NLP_AGENT_UPLOADS_ROOT=

# ------------------------------------------------------------------------ #
#  LangSmith tracing (optional)
# ------------------------------------------------------------------------ #
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=Nova

# ------------------------------------------------------------------------ #
#  Web / Monitor networking
# ------------------------------------------------------------------------ #
# Session signing secret for production Web/Monitor; must be replaced with a
# long random string.
NLP_AGENT_WEB_SECRET=CHANGE_ME_RANDOM_SECRET

# Runtime namespace and host-shared budget lock. Test and production must use
# different namespaces while sharing this lock directory on a single host.
NLP_AGENT_SANDBOX_NAMESPACE=local
NLP_AGENT_SANDBOX_HOST_LOCK_FILE=
NLP_AGENT_SANDBOX_HOST_RUNTIME_TOTAL_MAX=4
NOVA_SANDBOX_HOST_LOCK_DIR=/var/lock/nova-sandbox

NLP_AGENT_WEB_HOST=
NLP_AGENT_WEB_PORT=
NLP_AGENT_WEB_ALLOWED_HOSTS=localhost,127.0.0.1
NLP_AGENT_WEB_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
NLP_AGENT_WEB_BASE_URL=

NLP_AGENT_MONITOR_HOST=
NLP_AGENT_MONITOR_PORT=
NLP_AGENT_MONITOR_ALLOWED_HOSTS=localhost,127.0.0.1
NLP_AGENT_MONITOR_ALLOWED_ORIGINS=http://localhost:8766,http://127.0.0.1:8766
NLP_AGENT_MONITOR_BASE_URL=

# Monitor data retention policy (defaults enabled: trace 7 days / event 30 days)
NLP_AGENT_MONITOR_RETENTION_ENABLED=true
NLP_AGENT_MONITOR_RETENTION_TRACE_DAYS=7
NLP_AGENT_MONITOR_RETENTION_EVENT_DAYS=30
NLP_AGENT_MONITOR_RETENTION_INTERVAL_S=3600
NLP_AGENT_MONITOR_RETENTION_INITIAL_DELAY_S=30

# ------------------------------------------------------------------------ #
#  Auth / sessions
# ------------------------------------------------------------------------ #
# Production Web/Monitor does not read fixed accounts from .env; users come
# from the MySQL nlp_users table. The username/password hash below is only for
# the legacy test adapter or explicit bootstrap scenarios.
NLP_AGENT_AUTH_USERNAME=
NLP_AGENT_AUTH_PASSWORD_HASH=
NLP_AGENT_AUTH_ROLES=student

# Session & login security
NLP_AGENT_AUTH_SESSION_TTL_S=28800
# Legacy variable name, kept for backward compatibility; prefer
# NLP_AGENT_AUTH_SESSION_TTL_S above.
NLP_AGENT_AUTH_COOKIE_TTL_S=
NLP_AGENT_AUTH_IDLE_TIMEOUT_S=3600
NLP_AGENT_AUTH_MAX_LOGIN_ATTEMPTS=5
NLP_AGENT_AUTH_RATE_WINDOW_S=900
# Keep false during the HTTP/IP bootstrap phase; only switch to true once
# Nginx provides HTTPS.
NLP_AGENT_AUTH_COOKIE_SECURE=false

# Auditing successful reads produces high volume; denials and writes are always
# audited. Enable only for short-term troubleshooting.
NLP_AGENT_AUDIT_SUCCESSFUL_READS=false

# Explicit --live evaluation account; must be able to access the target
# workspace. Reading Monitor evidence requires the system:runtime:monitor role.
NLP_AGENT_EVALUATION_USERNAME=
NLP_AGENT_EVALUATION_PASSWORD=

# ------------------------------------------------------------------------ #
#  Database
# ------------------------------------------------------------------------ #
# MySQL is the only business-state store. Point local development at
# 127.0.0.1; Docker Compose uses the mysql service. In production, replace with
# an internal address and a strong password — never commit production passwords.
NLP_AGENT_DATABASE_URL=mysql+aiomysql://nlp_agent:CHANGE_ME@127.0.0.1:3306/nlp_agent?charset=utf8mb4
NLP_AGENT_DEPLOYMENT_ENV=unknown

# Connection pool and timeouts (keep the defaults unless you need otherwise)
NLP_AGENT_DB_POOL_SIZE=10
NLP_AGENT_DB_MAX_OVERFLOW=20
NLP_AGENT_DB_POOL_RECYCLE_S=1800
NLP_AGENT_DB_CONNECT_TIMEOUT_S=5
NLP_AGENT_DB_STATEMENT_TIMEOUT_S=30

# ------------------------------------------------------------------------ #
#  Gateway transport
# ------------------------------------------------------------------------ #
# Use in_process for single-process local development; switch to redis when
# deploying Web and Worker separately.
NLP_AGENT_GATEWAY_TRANSPORT=in_process
NLP_AGENT_REDIS_URL=redis://127.0.0.1:6379/0
# Set to 1 to enable the Redis-required integration test gate; leave empty in
# production.
NLP_AGENT_REDIS_INTEGRATION=
# Optional: shared MSSQL state adapter factory in package.module:function form.
NLP_AGENT_STATE_FACTORY=

# ------------------------------------------------------------------------ #
#  Quota / billing
# ------------------------------------------------------------------------ #
NLP_AGENT_QUOTA_ENFORCEMENT=true
# Optional: rollout percentage (0-100); leave empty to control via the
# users/workspaces allowlists.
NLP_AGENT_QUOTA_ENFORCEMENT_PERCENT=
NLP_AGENT_QUOTA_ENFORCEMENT_USERS=
NLP_AGENT_QUOTA_ENFORCEMENT_WORKSPACES=

# ------------------------------------------------------------------------ #
#  Teacher learning analytics
# ------------------------------------------------------------------------ #
# Timezone for hour/weekday distribution and peak-hour analysis (fixed offset,
# no DST support).
NLP_AGENT_ANALYTICS_TIMEZONE=Asia/Shanghai

# ------------------------------------------------------------------------ #
#  Sandbox
# ------------------------------------------------------------------------ #
# Mode: disabled / inprocess / managed. inprocess is for local development only
# and must not be used with untrusted code.
NLP_AGENT_SANDBOX_RUNTIME_MODE=disabled
NLP_AGENT_SANDBOX_RUNTIME_BACKEND=runsc
NLP_AGENT_SANDBOX_DOCKER_IMAGE_DIGEST=
NLP_AGENT_SANDBOX_KUBERNETES_CLIENT_FACTORY=
NLP_AGENT_SANDBOX_FIRECRACKER_KERNEL_IMAGE=
NLP_AGENT_SANDBOX_FIRECRACKER_ROOTFS_IMAGE=

# Warm pool & adaptive capacity
NLP_AGENT_SANDBOX_WARM_POOL_READY_TARGET=0
NLP_AGENT_SANDBOX_ADAPTIVE_POOL_ENABLED=false
NLP_AGENT_SANDBOX_WARM_POOL_READY_MIN=1
NLP_AGENT_SANDBOX_WARM_POOL_READY_MAX=3
NLP_AGENT_SANDBOX_RUNTIME_TOTAL_MAX=4
NLP_AGENT_SANDBOX_EXECUTION_CONCURRENCY_MAX=2
NLP_AGENT_SANDBOX_HOST_MEMORY_RESERVE_MB=3072
NLP_AGENT_SANDBOX_HOST_DISK_RESERVE_GB=15
NLP_AGENT_SANDBOX_BURST_BUFFER=1
NLP_AGENT_SANDBOX_ARRIVAL_RATE_PER_MIN=0.0
NLP_AGENT_SANDBOX_REFILL_P95_S=4.0
NLP_AGENT_SANDBOX_METRICS_SAMPLE_INTERVAL_S=30
NLP_AGENT_SANDBOX_FAULT_INJECTION=
NLP_AGENT_SANDBOX_PRELOAD_MATRIX_PATH=

# Ops / event retention & RPC budgets
NLP_AGENT_SANDBOX_RECONCILE_INTERVAL_S=30
NLP_AGENT_SANDBOX_EVENT_RETENTION_S=86400
NLP_AGENT_SANDBOX_EVENT_MAXLEN=10000
NLP_AGENT_SANDBOX_COMMAND_RETENTION_S=86400
NLP_AGENT_SANDBOX_MANAGER_RPC_TIMEOUT_S=75.0
NLP_AGENT_SANDBOX_METRICS_RETENTION_S=604800
NLP_AGENT_DOCKER_RUNTIME=

# Artifact & project storage
NLP_AGENT_SANDBOX_ARTIFACT_ORIGIN=
NLP_AGENT_SANDBOX_APPLICATION_ORIGIN=
NLP_AGENT_SANDBOX_ARTIFACT_STORE_ROOT=
NLP_AGENT_SANDBOX_ARTIFACT_TTL_S=3600
NLP_AGENT_SANDBOX_PROJECT_STORAGE_ENABLED=false
NLP_AGENT_SANDBOX_PROJECT_STORAGE_ROOT=
NLP_AGENT_SANDBOX_SNAPSHOTS_ENABLED=false
NLP_AGENT_USER_FILES_ROOT=
NLP_AGENT_USER_FILES_GLOBAL_LIMIT_BYTES=32212254720
NLP_AGENT_STORAGE_GLOBAL_DATA_LIMIT_BYTES=32212254720
NLP_AGENT_STORAGE_MIN_FREE_BYTES=16106127360
NLP_AGENT_STORAGE_TRASH_RETENTION_DAYS=7
NLP_AGENT_GUEST_STORAGE_RETENTION_DAYS=30

# Test/integration images (CI or sandbox integration tests only)
NLP_AGENT_SANDBOX_INTEGRATION_IMAGE=
NLP_AGENT_SANDBOX_MANAGER_TEST_IMAGE=alpine:3.20

# ------------------------------------------------------------------------ #
#  API HTTP adapter (dev/test)
# ------------------------------------------------------------------------ #
NLP_AGENT_API_HTTP_MCP_STUB=
NLP_AGENT_API_HTTP_RUNTIME_OVERRIDES=
NLP_AGENT_API_HTTP_SKILLS_ROOT=
NLP_AGENT_API_HTTP_EMAIL_PROVIDER=
NLP_AGENT_API_HTTP_EMAIL_FAILURE_PREFIX=

# ------------------------------------------------------------------------ #
#  Structured logging
# ------------------------------------------------------------------------ #
NLP_AGENT_LOG_STDOUT=true
NLP_AGENT_LOG_LEVEL=INFO
NLP_AGENT_LOG_DIR=logs
NLP_AGENT_LOG_SERVICE=
NLP_AGENT_LOG_RETENTION_DAYS=14

# ------------------------------------------------------------------------ #
#  Email verification (SMTP, production signup codes)
# ------------------------------------------------------------------------ #
# To enable real email verification, configure the SMTP variables below. Any
# SMTP-capable provider works: a personal mailbox (QQ / 163 / Gmail / Outlook
# authorization code) or a transactional service (Resend / Brevo / SendGrid /
# Amazon SES) via its SMTP endpoint. Without them the endpoint returns 503
# unless the development switch below is set to true (only then is the code
# printed to the local console).
#
# NLP_AGENT_SMTP_HOST=smtp.qq.com
# NLP_AGENT_SMTP_PORT=465
# NLP_AGENT_SMTP_SECURITY=ssl            # ssl | starttls | none
# NLP_AGENT_SMTP_USER=your-mailbox@example.com
# NLP_AGENT_SMTP_PASSWORD=your-authorization-code
# NLP_AGENT_SMTP_FROM=your-mailbox@example.com
NLP_AGENT_EMAIL_DEVELOPMENT_MODE=false
# Must stay false in production; enabling it writes the verification code to
# the local development log.
NLP_AGENT_EMAIL_EXPOSE_CODE=false

# ------------------------------------------------------------------------ #
#  Docker Compose deployment
# ------------------------------------------------------------------------ #
NLP_AGENT_MYSQL_DATABASE=nlp_agent
NLP_AGENT_MYSQL_USER=nlp_agent
NLP_AGENT_MYSQL_PASSWORD=CHANGE_ME
NLP_AGENT_MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT

# Edge deployment image/network
NOVA_IMAGE_REF=nova-agent:local
NOVA_PULL_POLICY=always
NOVA_ENV_FILE=.env
NOVA_WEB_HOST_PORT=80
NOVA_NGINX_HTTP_PORT=80
NOVA_MONITOR_HOST_PORT=8766
NOVA_MONITOR_BIND_ADDRESS=127.0.0.1

# Outbound network: corporate proxy and direct-connect domains (defaults to
# direct connection to domestic model domains).
NOVA_OUTBOUND_PROXY_URL=
NOVA_DIRECT_DOMAINS=.cn,.中国,api.deepseek.com,dashscope.aliyuncs.com,api.moonshot.cn,open.bigmodel.cn
