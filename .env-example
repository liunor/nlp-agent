# ========================================================================== #
#  Nova 环境配置示例（复制为 .env 后填写）
#  - 带 CHANGE_ME / xxx 的项必须替换为你自己的值，不要提交到 Git。
#  - 空值表示不启用该可选功能；带布尔值的项支持 true/false、1/0、yes/no。
#  - 完整说明见 docs/ 与 configs/settings.py。
# ========================================================================== #

# ------------------------------------------------------------------------ #
#  模型供应商密钥
# ------------------------------------------------------------------------ #
DEEPSEEK_API_KEY=xxx
QWEN_API_KEY=xxx
KIMI_API_KEY=xxx
GLM_API_KEY=xxx

# 旧供应商密钥（如仍在使用，才需要填写）
volcengine_API_KEY=
aliyun_API_KEY=

# 可选：强制 Worker 使用指定模型，覆盖 agent_config.yaml 的默认 worker 模型。
# 留空则使用配置文件的 worker 默认值。
NLP_AGENT_WORKER_MODEL=

# ------------------------------------------------------------------------ #
#  学术搜索 / 语义学者 / Crossref
# ------------------------------------------------------------------------ #
# 可选；不配置时使用 Semantic Scholar 未认证公共限额。
# 默认许可仅适用于内部、非商业研究/教育用途；公开/商业部署前必须复核
# https://api.semanticscholar.org/license/ 并完成品牌归因或取得扩展许可。
SEMANTIC_SCHOLAR_API_KEY=

# 推荐填写维护邮箱，用于 Crossref polite pool，不是密钥。
ACADEMIC_CROSSREF_MAILTO=

# ------------------------------------------------------------------------ #
#  视觉 / OCR
# ------------------------------------------------------------------------ #
# 可选：使用云 OCR 时配置；本地 OCR 不需要。
NLP_AGENT_OCR_API_KEY=

# 文件上传持久化目录；默认 .data/uploads。
NLP_AGENT_UPLOADS_ROOT=

# ------------------------------------------------------------------------ #
#  LangSmith 追踪（可选）
# ------------------------------------------------------------------------ #
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=Nova

# ------------------------------------------------------------------------ #
#  Web / Monitor 网络
# ------------------------------------------------------------------------ #
# 生产 Web/Monitor 使用的会话签名密钥；必须改成随机长字符串。
NLP_AGENT_WEB_SECRET=CHANGE_ME_RANDOM_SECRET

NLP_AGENT_WEB_HOST=
NLP_AGENT_WEB_PORT=
NLP_AGENT_WEB_ALLOWED_HOSTS=localhost,127.0.0.1
NLP_AGENT_WEB_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
NLP_AGENT_WEB_BASE_URL=

NLP_AGENT_MONITOR_HOST=
NLP_AGENT_MONITOR_PORT=
NLP_AGENT_MONITOR_ALLOWED_HOSTS=localhost,127.0.0.1
NLP_AGENT_MONITOR_ALLOWED_ORIGINS=http://localhost:8766,http://127.0.0.1:8766
NLP_AGENT_MONITOR_BASE_URL=

# Monitor 数据保留策略（默认开启：trace 7 天 / event 30 天）
NLP_AGENT_MONITOR_RETENTION_ENABLED=true
NLP_AGENT_MONITOR_RETENTION_TRACE_DAYS=7
NLP_AGENT_MONITOR_RETENTION_EVENT_DAYS=30
NLP_AGENT_MONITOR_RETENTION_INTERVAL_S=3600
NLP_AGENT_MONITOR_RETENTION_INITIAL_DELAY_S=30

# ------------------------------------------------------------------------ #
#  认证 / 会话
# ------------------------------------------------------------------------ #
# 生产 Web/Monitor 不从 .env 读取固定账号；用户来自 MySQL nlp_users。
# 下面的用户名/密码哈希仅用于旧测试适配器或显式引导场景。
NLP_AGENT_AUTH_USERNAME=
NLP_AGENT_AUTH_PASSWORD_HASH=
NLP_AGENT_AUTH_ROLES=student

# 会话与登录安全
NLP_AGENT_AUTH_SESSION_TTL_S=28800
# 旧变量名，仅作向后兼容；优先使用上面的 NLP_AGENT_AUTH_SESSION_TTL_S。
NLP_AGENT_AUTH_COOKIE_TTL_S=
NLP_AGENT_AUTH_IDLE_TIMEOUT_S=3600
NLP_AGENT_AUTH_MAX_LOGIN_ATTEMPTS=5
NLP_AGENT_AUTH_RATE_WINDOW_S=900
# HTTP/IP 引导阶段保持 false；只有在 Nginx 提供 HTTPS 之后才能改 true。
NLP_AGENT_AUTH_COOKIE_SECURE=false

# 成功读权限的审计量很大；denials 与写操作始终审计。仅短期排障时开启。
NLP_AGENT_AUDIT_SUCCESSFUL_READS=false

# 显式 --live 评测账号；需能访问目标 workspace，读取 Monitor 证据需要 system:runtime:monitor 权限。
NLP_AGENT_EVALUATION_USERNAME=
NLP_AGENT_EVALUATION_PASSWORD=

# ------------------------------------------------------------------------ #
#  数据库
# ------------------------------------------------------------------------ #
# MySQL 是唯一的业务状态库。本地开发指向 127.0.0.1；Docker Compose 用 mysql。
# 生产环境请替换成内网地址并配置强密码，切勿提交生产密码。
NLP_AGENT_DATABASE_URL=mysql+aiomysql://nlp_agent:CHANGE_ME@127.0.0.1:3306/nlp_agent?charset=utf8mb4

# 连接池与超时（无特殊需求可保持默认）
NLP_AGENT_DB_POOL_SIZE=10
NLP_AGENT_DB_MAX_OVERFLOW=20
NLP_AGENT_DB_POOL_RECYCLE_S=1800
NLP_AGENT_DB_CONNECT_TIMEOUT_S=5
NLP_AGENT_DB_STATEMENT_TIMEOUT_S=30

# ------------------------------------------------------------------------ #
#  Gateway 传输
# ------------------------------------------------------------------------ #
# 单进程本地开发用 in_process；Web 与 Worker 分离部署时改成 redis。
NLP_AGENT_GATEWAY_TRANSPORT=in_process
NLP_AGENT_REDIS_URL=redis://127.0.0.1:6379/0
# 取值为 1 时启用需要 Redis 的集成测试门禁；生产留空即可。
NLP_AGENT_REDIS_INTEGRATION=
# 可选：package.module:function 形式的共享 MSSQL 状态适配器工厂。
NLP_AGENT_STATE_FACTORY=

# ------------------------------------------------------------------------ #
#  额度 / 计费托管
# ------------------------------------------------------------------------ #
NLP_AGENT_QUOTA_ENFORCEMENT=true
# 可选：灰度百分比（0-100）；留空则按 users/workspaces 名单控制。
NLP_AGENT_QUOTA_ENFORCEMENT_PERCENT=
NLP_AGENT_QUOTA_ENFORCEMENT_USERS=
NLP_AGENT_QUOTA_ENFORCEMENT_WORKSPACES=

# ------------------------------------------------------------------------ #
#  教师学习分析
# ------------------------------------------------------------------------ #
# 小时/星期分布与高峰时段使用的时区（固定偏移，不支持夏令时）。
NLP_AGENT_ANALYTICS_TIMEZONE=Asia/Shanghai

# ------------------------------------------------------------------------ #
#  沙箱
# ------------------------------------------------------------------------ #
# 模式：disabled / inprocess / managed。inprocess 仅限本地开发，不可用于不可信代码。
NLP_AGENT_SANDBOX_RUNTIME_MODE=disabled
NLP_AGENT_SANDBOX_RUNTIME_BACKEND=runsc
NLP_AGENT_SANDBOX_DOCKER_IMAGE_DIGEST=
NLP_AGENT_SANDBOX_KUBERNETES_CLIENT_FACTORY=
NLP_AGENT_SANDBOX_FIRECRACKER_KERNEL_IMAGE=
NLP_AGENT_SANDBOX_FIRECRACKER_ROOTFS_IMAGE=

# 暖池与自适应容量
NLP_AGENT_SANDBOX_WARM_POOL_READY_TARGET=0
NLP_AGENT_SANDBOX_ADAPTIVE_POOL_ENABLED=false
NLP_AGENT_SANDBOX_WARM_POOL_READY_MIN=1
NLP_AGENT_SANDBOX_WARM_POOL_READY_MAX=5
NLP_AGENT_SANDBOX_BURST_BUFFER=1
NLP_AGENT_SANDBOX_ARRIVAL_RATE_PER_MIN=0.0
NLP_AGENT_SANDBOX_REFILL_P95_S=4.0
NLP_AGENT_SANDBOX_FAULT_INJECTION=
NLP_AGENT_SANDBOX_PRELOAD_MATRIX_PATH=

# 运维/事件保留与 RPC 预算
NLP_AGENT_SANDBOX_RECONCILE_INTERVAL_S=30
NLP_AGENT_SANDBOX_EVENT_RETENTION_S=86400
NLP_AGENT_SANDBOX_EVENT_MAXLEN=10000
NLP_AGENT_SANDBOX_COMMAND_RETENTION_S=86400
NLP_AGENT_SANDBOX_MANAGER_RPC_TIMEOUT_S=75.0
NLP_AGENT_SANDBOX_METRICS_RETENTION_S=604800
NLP_AGENT_DOCKER_RUNTIME=

# 制品与项目存储
NLP_AGENT_SANDBOX_ARTIFACT_ORIGIN=
NLP_AGENT_SANDBOX_APPLICATION_ORIGIN=
NLP_AGENT_SANDBOX_ARTIFACT_STORE_ROOT=
NLP_AGENT_SANDBOX_ARTIFACT_TTL_S=3600
NLP_AGENT_SANDBOX_PROJECT_STORAGE_ENABLED=false
NLP_AGENT_SANDBOX_PROJECT_STORAGE_ROOT=
NLP_AGENT_SANDBOX_SNAPSHOTS_ENABLED=false

# 测试/集成镜像（仅 CI 或沙箱集成测试使用）
NLP_AGENT_SANDBOX_INTEGRATION_IMAGE=
NLP_AGENT_SANDBOX_MANAGER_TEST_IMAGE=alpine:3.20

# ------------------------------------------------------------------------ #
#  API HTTP 适配（开发/测试用）
# ------------------------------------------------------------------------ #
NLP_AGENT_API_HTTP_MCP_STUB=
NLP_AGENT_API_HTTP_RUNTIME_OVERRIDES=
NLP_AGENT_API_HTTP_SKILLS_ROOT=
NLP_AGENT_API_HTTP_SMS_PROVIDER=
NLP_AGENT_API_HTTP_SMS_FAILURE_PREFIX=

# ------------------------------------------------------------------------ #
#  结构化日志
# ------------------------------------------------------------------------ #
NLP_AGENT_LOG_STDOUT=true
NLP_AGENT_LOG_LEVEL=INFO
NLP_AGENT_LOG_DIR=logs
NLP_AGENT_LOG_SERVICE=
NLP_AGENT_LOG_RETENTION_DAYS=14

# ------------------------------------------------------------------------ #
#  腾讯云短信（生产短信验证码）
# ------------------------------------------------------------------------ #
# 不配置以下 SecretId/SecretKey/模板时，短信接口只有在
# NLP_AGENT_SMS_DEVELOPMENT_MODE=true 时才可用（验证码打印到本机日志）。
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
NLP_AGENT_SMS_DEVELOPMENT_MODE=false
# 生产必须保持 false；开启会把验证码写入本地开发日志。
NLP_AGENT_SMS_EXPOSE_CODE=false

# ------------------------------------------------------------------------ #
#  Docker Compose 部署
# ------------------------------------------------------------------------ #
NLP_AGENT_MYSQL_DATABASE=nlp_agent
NLP_AGENT_MYSQL_USER=nlp_agent
NLP_AGENT_MYSQL_PASSWORD=CHANGE_ME
NLP_AGENT_MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT

# 边缘部署镜像/网络
NOVA_IMAGE_REF=nova-agent:local
NOVA_PULL_POLICY=always
NOVA_ENV_FILE=.env
NOVA_WEB_HOST_PORT=80
NOVA_NGINX_HTTP_PORT=80
NOVA_MONITOR_HOST_PORT=8766
NOVA_MONITOR_BIND_ADDRESS=127.0.0.1

# 出站网络：企业代理与直连域名（默认直连国内模型域名）
NOVA_OUTBOUND_PROXY_URL=
NOVA_DIRECT_DOMAINS=.cn,.中国,api.deepseek.com,dashscope.aliyuncs.com,api.moonshot.cn,open.bigmodel.cn
