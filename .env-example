# Doubao-Seed-1.8配置
volcengine_API_KEY="xxx"

# 阿里云 embedding模型配置
aliyun_API_KEY="xxx"

# LangSmith配置
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY="xxx"

# 选填，建议填上，方便在界面里分类
LANGCHAIN_PROJECT="Agent"

# Tavily 搜索
TAVILY_API_KEY = "xxx"

# DeepSeek配置
DEEPSEEK_API_KEY=xxx

# web 登录会话的签名秘钥
NLP_AGENT_WEB_SECRET="xxx"

# Nova 固定登录账号。密码必须填写 Argon2id 哈希，不要填写明文密码。
NLP_AGENT_AUTH_USERNAME="nova"
NLP_AGENT_AUTH_PASSWORD_HASH="$argon2id$v=19$m=19456,t=2,p=1$..."
NLP_AGENT_AUTH_ROLES="student"
NLP_AGENT_AUTH_SESSION_TTL_S=1800
NLP_AGENT_AUTH_IDLE_TIMEOUT_S=900
NLP_AGENT_AUTH_MAX_LOGIN_ATTEMPTS=5
NLP_AGENT_AUTH_RATE_WINDOW_S=300
NLP_AGENT_AUTH_COOKIE_SECURE=false

# Docker / internal network deployment. Replace SERVER_IP_OR_DOMAIN before use.
# Example: 192.168.1.20 or nova.example.internal
NLP_AGENT_WEB_ALLOWED_HOSTS="localhost,127.0.0.1,SERVER_IP_OR_DOMAIN"
NLP_AGENT_WEB_ALLOWED_ORIGINS="http://SERVER_IP_OR_DOMAIN:8765"
NLP_AGENT_MONITOR_ALLOWED_HOSTS="localhost,127.0.0.1,SERVER_IP_OR_DOMAIN"
NLP_AGENT_MONITOR_ALLOWED_ORIGINS="http://SERVER_IP_OR_DOMAIN:8766"

# Docker image source. Local development can keep the default values;
# test/production servers should pull the image published by GitHub Actions.
NOVA_IMAGE="ghcr.io/liunor/nlp-agent"
NOVA_TAG="develop"
NOVA_PULL_POLICY="always"

# 内容安全
CONTENT_SAFETY_ENABLED=true
CONTENT_SAFETY_PROVIDER=DEEPSET
# 提示词安全
PROMPT_INJECTION_ENABLED=true
PROMPT_THRESHOLD=MEDIUM
# 工具安全
TOOL_GUARD_ENABLED=true
# 审计日志
AUDIT_LOG_ENABLED=true
AUDIT_LOG_DIR=logs/audit