# Copy this file to /opt/nova-test/.env on the test server.
# Keep the resulting .env on the server only; it must never be committed.

# Required model and session configuration.
DEEPSEEK_API_KEY="REPLACE_WITH_TEST_MODEL_KEY"
QWEN_API_KEY="REPLACE_WITH_TEST_QWEN_KEY"

# Test-only MySQL instance and credentials.
NLP_AGENT_MYSQL_DATABASE="nlp_agent_test"
NLP_AGENT_MYSQL_USER="nlp_agent_test"
NLP_AGENT_MYSQL_PASSWORD="REPLACE_WITH_TEST_MYSQL_PASSWORD"
NLP_AGENT_MYSQL_ROOT_PASSWORD="REPLACE_WITH_TEST_MYSQL_ROOT_PASSWORD"
NLP_AGENT_DATABASE_URL="mysql+aiomysql://nlp_agent_test:REPLACE_WITH_TEST_MYSQL_PASSWORD@mysql:3306/nlp_agent_test?charset=utf8mb4"

# Accounts, passwords and roles are managed in MySQL by the developer
# platform. Do not put user credentials in this deployment file.
NLP_AGENT_AUTH_SESSION_TTL_S=1800
NLP_AGENT_AUTH_IDLE_TIMEOUT_S=900
NLP_AGENT_AUTH_MAX_LOGIN_ATTEMPTS=5
NLP_AGENT_AUTH_RATE_WINDOW_S=300
NLP_AGENT_AUTH_COOKIE_SECURE=false
NLP_AGENT_WEB_SECRET="REPLACE_WITH_RANDOM_32_BYTE_TEST_SECRET"

# The Linux CI/test deployment runs the isolated Manager separately from Web.
# The deployment workflow replaces this value with the exact runtime digest
# published by the current run; it is safe to leave the placeholder here.
NLP_AGENT_SANDBOX_RUNTIME_MODE=docker
NLP_AGENT_SANDBOX_RUNTIME_BACKEND=runsc
NLP_AGENT_SANDBOX_DOCKER_IMAGE_DIGEST="ghcr.io/liunor/nova-sandbox-runtime@sha256:REPLACE_WITH_CI_DIGEST"
# Only required when opting into the Kubernetes backend.  The factory is
# imported and called exclusively by the isolated Sandbox Manager process.
NLP_AGENT_SANDBOX_KUBERNETES_CLIENT_FACTORY=""
NLP_AGENT_SANDBOX_FIRECRACKER_KERNEL_IMAGE=""
NLP_AGENT_SANDBOX_FIRECRACKER_ROOTFS_IMAGE=""
NLP_AGENT_SANDBOX_WARM_POOL_READY_TARGET=1
NLP_AGENT_SANDBOX_ADAPTIVE_POOL_ENABLED=true
NLP_AGENT_SANDBOX_MANAGER_RPC_TIMEOUT_S=75
NLP_AGENT_SANDBOX_PROJECT_STORAGE_ENABLED=false
NLP_AGENT_SANDBOX_SNAPSHOTS_ENABLED=false

# The test workflow replaces this value with the exact digest it just published.
NOVA_IMAGE_REF="ghcr.io/liunor/nlp-agent:develop"
NOVA_PULL_POLICY="always"
NOVA_WEB_HOST_PORT="18765"
NOVA_MONITOR_HOST_PORT="18766"

# Replace TEST_SERVER_IP_OR_DOMAIN with the actual internal address.
NLP_AGENT_WEB_ALLOWED_HOSTS="localhost,127.0.0.1,TEST_SERVER_IP_OR_DOMAIN"
NLP_AGENT_WEB_ALLOWED_ORIGINS="http://TEST_SERVER_IP_OR_DOMAIN:18765"
NLP_AGENT_MONITOR_ALLOWED_HOSTS="localhost,127.0.0.1,TEST_SERVER_IP_OR_DOMAIN"
NLP_AGENT_MONITOR_ALLOWED_ORIGINS="http://TEST_SERVER_IP_OR_DOMAIN:18766"

# Optional observability integration.
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="Nova-Test"
