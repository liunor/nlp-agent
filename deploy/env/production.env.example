# Copy this file to /opt/nova-prod/.env on the production server.
# Keep the resulting .env on the server only; it must never be committed.

# Required model and session configuration. Use production-only credentials.
DEEPSEEK_API_KEY="REPLACE_WITH_PRODUCTION_MODEL_KEY"
QWEN_API_KEY="REPLACE_WITH_PRODUCTION_QWEN_KEY"
KIMI_API_KEY="REPLACE_WITH_PRODUCTION_KIMI_KEY"
GLM_API_KEY="REPLACE_WITH_PRODUCTION_GLM_KEY"

# Production-only MySQL instance and credentials.
NLP_AGENT_MYSQL_DATABASE="nlp_agent_prod"
NLP_AGENT_MYSQL_USER="nlp_agent_prod"
NLP_AGENT_MYSQL_PASSWORD="REPLACE_WITH_PRODUCTION_MYSQL_PASSWORD"
NLP_AGENT_MYSQL_ROOT_PASSWORD="REPLACE_WITH_PRODUCTION_MYSQL_ROOT_PASSWORD"
NLP_AGENT_DATABASE_URL="mysql+aiomysql://nlp_agent_prod:REPLACE_WITH_PRODUCTION_MYSQL_PASSWORD@mysql:3306/nlp_agent_prod?charset=utf8mb4"
NLP_AGENT_DEPLOYMENT_ENV="production"

# Accounts, passwords and roles are managed in MySQL by the developer
# platform. Do not put user credentials in this deployment file.
NLP_AGENT_AUTH_SESSION_TTL_S=1800
NLP_AGENT_AUTH_IDLE_TIMEOUT_S=900
NLP_AGENT_AUTH_MAX_LOGIN_ATTEMPTS=5
NLP_AGENT_AUTH_RATE_WINDOW_S=300
NLP_AGENT_AUTH_COOKIE_SECURE=true
NLP_AGENT_WEB_SECRET="REPLACE_WITH_RANDOM_32_BYTE_SECRET"

# Phase 4 isolated Sandbox Manager.  The manager is the only Compose service
# with the Docker socket; Web reaches it through Redis RPC. The release
# workflow replaces the runtime image with the approved immutable digest.
NLP_AGENT_SANDBOX_RUNTIME_MODE=docker
NLP_AGENT_SANDBOX_RUNTIME_BACKEND=runsc
NLP_AGENT_SANDBOX_DOCKER_IMAGE_DIGEST="ghcr.io/liunor/nova-sandbox-runtime@sha256:REPLACE_WITH_CI_DIGEST"
NLP_AGENT_SANDBOX_NAMESPACE="prod"
NLP_AGENT_SANDBOX_HOST_LOCK_FILE="/run/nova-sandbox-lock/host.lock"
NLP_AGENT_SANDBOX_HOST_RUNTIME_TOTAL_MAX=4
# Only required when opting into the Kubernetes backend.  The factory is
# imported and called exclusively by the isolated Sandbox Manager process.
NLP_AGENT_SANDBOX_KUBERNETES_CLIENT_FACTORY=""
NLP_AGENT_SANDBOX_FIRECRACKER_KERNEL_IMAGE=""
NLP_AGENT_SANDBOX_FIRECRACKER_ROOTFS_IMAGE=""
NLP_AGENT_SANDBOX_WARM_POOL_READY_TARGET=2
NLP_AGENT_SANDBOX_ADAPTIVE_POOL_ENABLED=true
NLP_AGENT_SANDBOX_WARM_POOL_READY_MIN=2
NLP_AGENT_SANDBOX_WARM_POOL_READY_MAX=3
NLP_AGENT_SANDBOX_RUNTIME_TOTAL_MAX=4
NLP_AGENT_SANDBOX_EXECUTION_CONCURRENCY_MAX=2
NLP_AGENT_SANDBOX_HOST_MEMORY_RESERVE_MB=3072
NLP_AGENT_SANDBOX_HOST_DISK_RESERVE_GB=15
NLP_AGENT_SANDBOX_METRICS_SAMPLE_INTERVAL_S=30
NLP_AGENT_SANDBOX_MANAGER_RPC_TIMEOUT_S=75
NLP_AGENT_SANDBOX_PROJECT_STORAGE_ENABLED=false
NLP_AGENT_STORAGE_GLOBAL_DATA_LIMIT_BYTES=32212254720
NLP_AGENT_STORAGE_MIN_FREE_BYTES=16106127360
NLP_AGENT_STORAGE_TRASH_RETENTION_DAYS=7
NLP_AGENT_GUEST_STORAGE_RETENTION_DAYS=30
NLP_AGENT_SANDBOX_SNAPSHOTS_ENABLED=false

# The release workflow replaces this with the exact immutable digest approved
# in test; it is safe to leave the template value here.
NOVA_IMAGE_REF="ghcr.io/liunor/nlp-agent:v1.0.0"
NOVA_PULL_POLICY="always"
NOVA_WEB_HOST_PORT="8765"
NOVA_MONITOR_HOST_PORT="8766"
NOVA_SANDBOX_HOST_LOCK_DIR="/var/lock/nova-sandbox"

# Application logs are visible in Docker logs and retained in the nova-logs volume.
NLP_AGENT_LOG_STDOUT="true"
NLP_AGENT_LOG_LEVEL="INFO"
NLP_AGENT_LOG_RETENTION_DAYS="14"

# Optional outbound proxy for academic providers and web_fetch. When the
# proxy runs on the Docker host, use host.docker.internal rather than 127.0.0.1.
# The proxy must accept connections on the Docker-reachable host interface;
# listening only on 127.0.0.1 is not reachable from a Compose container.
NOVA_OUTBOUND_PROXY_URL=""
# Comma-separated domains that bypass the proxy. Chinese domains are direct by
# default; add an exact provider domain here when a domestic endpoint is added.
NOVA_DIRECT_DOMAINS=".cn,.xn--fiqs8s,api.deepseek.com,dashscope.aliyuncs.com,api.moonshot.cn,open.bigmodel.cn,ses.tencentcloudapi.com"

# Application logs are visible in Docker logs and retained in the nova-logs volume.
NLP_AGENT_LOG_STDOUT="true"
NLP_AGENT_LOG_LEVEL="INFO"
NLP_AGENT_LOG_RETENTION_DAYS="14"

# Replace PROD_SERVER_IP_OR_DOMAIN with the actual internal address.
NLP_AGENT_WEB_ALLOWED_HOSTS="localhost,127.0.0.1,PROD_SERVER_IP_OR_DOMAIN"
NLP_AGENT_WEB_ALLOWED_ORIGINS="http://PROD_SERVER_IP_OR_DOMAIN:8765"
NLP_AGENT_MONITOR_ALLOWED_HOSTS="localhost,127.0.0.1,PROD_SERVER_IP_OR_DOMAIN"
NLP_AGENT_MONITOR_ALLOWED_ORIGINS="http://PROD_SERVER_IP_OR_DOMAIN:8766"

# Optional observability integration. Use production-only credentials when enabled.
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="Nova-Production"

# ------------------------------------------------------------------ #
#  SMTP Email (required for real verification emails in production)
# ------------------------------------------------------------------ #
# These variables are required in production. Missing credentials make the
# email endpoint return 503; verification codes are never written to logs.
# Any SMTP-capable provider works (personal mailbox authorization code or a
# transactional service such as Resend / Brevo / SendGrid / Amazon SES).
NLP_AGENT_EMAIL_DEVELOPMENT_MODE=false
# Never enable in production; it writes verification codes to application logs.
NLP_AGENT_EMAIL_EXPOSE_CODE=false
# NLP_AGENT_SMTP_HOST="smtp.qq.com"
# NLP_AGENT_SMTP_PORT="465"
# NLP_AGENT_SMTP_SECURITY="ssl"
# NLP_AGENT_SMTP_USER="REPLACE_WITH_SMTP_USER"
# NLP_AGENT_SMTP_PASSWORD="REPLACE_WITH_SMTP_AUTHORIZATION_CODE"
# NLP_AGENT_SMTP_FROM="REPLACE_WITH_SENDER_ADDRESS"
