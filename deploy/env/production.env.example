# Copy this file to /opt/nova-prod/.env on the production server.
# Keep the resulting .env on the server only; it must never be committed.

# Required model and session configuration. Use production-only credentials.
DEEPSEEK_API_KEY="REPLACE_WITH_PRODUCTION_MODEL_KEY"
QWEN_API_KEY="REPLACE_WITH_PRODUCTION_QWEN_KEY"

# Production-only MySQL instance and credentials.
NLP_AGENT_MYSQL_DATABASE="nlp_agent_prod"
NLP_AGENT_MYSQL_USER="nlp_agent_prod"
NLP_AGENT_MYSQL_PASSWORD="REPLACE_WITH_PRODUCTION_MYSQL_PASSWORD"
NLP_AGENT_MYSQL_ROOT_PASSWORD="REPLACE_WITH_PRODUCTION_MYSQL_ROOT_PASSWORD"
NLP_AGENT_DATABASE_URL="mysql+aiomysql://nlp_agent_prod:REPLACE_WITH_PRODUCTION_MYSQL_PASSWORD@mysql:3306/nlp_agent_prod?charset=utf8mb4"

# Accounts, passwords and roles are managed in MySQL by the developer
# platform. Do not put user credentials in this deployment file.
NLP_AGENT_AUTH_SESSION_TTL_S=1800
NLP_AGENT_AUTH_IDLE_TIMEOUT_S=900
NLP_AGENT_AUTH_MAX_LOGIN_ATTEMPTS=5
NLP_AGENT_AUTH_RATE_WINDOW_S=300
NLP_AGENT_AUTH_COOKIE_SECURE=true

# The release workflow replaces this with the exact digest approved in test.
NOVA_IMAGE_REF="ghcr.io/liunor/nlp-agent:v1.0.0"
NOVA_PULL_POLICY="always"
NOVA_WEB_HOST_PORT="8765"
NOVA_MONITOR_HOST_PORT="8766"

# Replace PROD_SERVER_IP_OR_DOMAIN with the actual internal address.
NLP_AGENT_WEB_ALLOWED_HOSTS="localhost,127.0.0.1,PROD_SERVER_IP_OR_DOMAIN"
NLP_AGENT_WEB_ALLOWED_ORIGINS="http://PROD_SERVER_IP_OR_DOMAIN:8765"
NLP_AGENT_MONITOR_ALLOWED_HOSTS="localhost,127.0.0.1,PROD_SERVER_IP_OR_DOMAIN"
NLP_AGENT_MONITOR_ALLOWED_ORIGINS="http://PROD_SERVER_IP_OR_DOMAIN:8766"

# Optional observability integration. Use production-only credentials when enabled.
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="Nova-Production"
